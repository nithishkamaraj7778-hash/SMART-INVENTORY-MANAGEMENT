# Server
PORT=5001
HOST=0.0.0.0

# MySQL (optional — app falls back to SQLite if MySQL is unavailable)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=inventory_db

# Optional SQLite path for local development; SQLite is not persistent on Vercel.
SQLITE_DATABASE_PATH=database/inventory.db

# Railway MySQL uses MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD,
# and MYSQLDATABASE automatically. DB_* values take precedence if both exist.
