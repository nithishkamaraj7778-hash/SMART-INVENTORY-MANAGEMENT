# Server
PORT=5001
HOST=0.0.0.0

# PostgreSQL (Neon on Vercel; PostgreSQL is required in production)
DATABASE_URL=

# Optional MySQL for local development
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=inventory_db

# Optional SQLite path for local development; SQLite is not persistent on Vercel.
SQLITE_DATABASE_PATH=database/inventory.db
